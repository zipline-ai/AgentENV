  "rules": {
    "InitialBindRequest": [
      {
        "equal": [
          "binding.transition_id",
          "saved_dispatch.creation_or_transition_id"
        ]
      },
      {
        "equal": [
          "binding.reserved_session_id",
          "saved_dispatch.reserved_session_id"
        ]
      },
      {
        "absent": "binding.launch_id"
      },
      {
        "absent": "saved_dispatch.launch_id"
      },
